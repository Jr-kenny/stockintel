# Base integration — copy to .env and fill in.
# Without a signer key the app runs in sandbox mode (deterministic local roots).

# mainnet | testnet
BASE_NETWORK=testnet

# Funded signer key on the target Base network (server-side only, never expose).
# Pays anchor gas and sends USDC payouts to contributing agents.
BASE_SIGNER_KEY=

# Optional overrides (defaults come from the network preset)
# BASE_RPC_URL=https://sepolia.base.org        # testnet default
# BASE_RPC_URL=https://mainnet.base.org        # mainnet default

# 0G Compute Router — LLM grading (API only; independent of the chain).
# Create a key at https://pc.0g.ai (mainnet), deposit a little 0G, and paste
# the sk-... key here. Without it grading runs in deterministic mode (same
# pipeline, local weights only).
ZERO_G_COMPUTE_API_KEY=
# Optional: model override (catalog id, default zai-org/GLM-5-FP8)
ZERO_G_COMPUTE_MODEL=
# Optional: explicit router base URL (default: https://router-api.0g.ai/v1)
ZERO_G_COMPUTE_BASE_URL=

# Agentic ID (ERC-7857) — onchain identity NFTs for grid agents.
# Deploy an iMint-compatible identity contract on Base, then set:
# AGENTIC_ID_CONTRACT=0x...
# AGENTIC_ID_DISABLED=true      # or turn minting off entirely

# USDC payouts — real stablecoin settlements to contributing agents from the
# BASE_SIGNER_KEY signer. All optional; sane defaults apply:
# PRIME_PAYOUT_BUDGET_USD=25     # max USDC paid out per inquiry cycle
# PRIME_MIN_PAYOUT_USD=0.01      # dust guard; smaller shares wait for retry
# PRIME_GAS_RESERVE_ETH=0.0002   # never spend the signer's ETH below this
# BASE_PAY_DISABLED=true         # kill-switch: rows stay pending, no transfers

# Privy (email sign-in for workspaces). Create an app at https://dashboard.privy.io
VITE_PRIVY_APP_ID=

# OpenRouter thesis provider (default when keyed). Free default model, no
# spend. Get a key at https://openrouter.ai/keys and set:
OPENROUTER_API_KEY=
# Optional model override. Default is minimax/minimax-m3:free (verified live).
# Other free candidates: z-ai/glm-5.2:free,
# nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free,
# minimax/minimax-m2.7:free.
# OPENROUTER_MODEL=z-ai/glm-5.2:free
# PRIME_GRADE_MODEL=google/gemini-2.5-flash

# OpenCode Zen backup, includes free models. Thesis chain: OpenRouter, 0G, Zen.
# Get a key at https://opencode.ai/auth and set:
# OPENCODE_ZEN_API_KEY=
# Free chat models that work with zero extra code:
# ZEN_MODEL=mimo-v2.5-free
# ZEN_MODEL=ling-3.0-flash-fin-free
# ZEN_MODEL=nemotron-3-ultra-free
# ZEN_MODEL=big-pickle
# Responses API models like Muse Spark free also work:
# ZEN_MODEL=muse-spark-1.3-contributor-free

# ── Virtuals ACP (Agent Commerce Protocol) ─────────────────────────────────
# Sells demand readouts + buys specialist intel via escrowed ACP jobs on Base.
# Register an agent at https://app.virtuals.io/acp/new first, then:
# ACP_WALLET_ADDRESS=0x...
# ACP_PRIVATE_KEY=
# ACP_ENTITY_ID=1
# ACP_CHAIN_ID=84532              # 84532 = Base Sepolia, 8453 = Base mainnet
# Run the node: bun scripts/acp-agent.ts

# ── Binance Agent OS (Track A market check) ─────────────────────────────────
# The MCP server lives at https://www.binance.com/mcp/agentic and speaks
# OAuth user authorization, not API keys. There is no web page to open.
# Connect from an MCP client instead (Claude Code shown, Cursor and Claude
# Desktop work the same way):
#   claude mcp add binance-mcp-server --transport http https://www.binance.com/mcp/agentic
# Then in the client: /mcp, select it, Authenticate in the browser, pick the
# agent, grant read-only market data plus read-only account on the Agentic
# sub-account. No trade or transfer scopes, ever.
# Server-side use needs a user token, if Binance issues one for your login:
# BINANCE_MCP_TOKEN=
# Without a token the app uses Binance official public mirror instead and
# the readout badge says so honestly.
# Optional overrides (defaults follow the MCP discovery spec):
# AGENT_OS_MCP_URL=https://www.binance.com/mcp/agentic
# BINANCE_OAUTH_AUTHORIZE_URL=
# BINANCE_OAUTH_TOKEN_URL=
